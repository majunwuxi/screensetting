{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallpaper Studio",
  "version": "2.0.0",
  "identifier": "trade.wxwellmax.wallpaperstudio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wallpaper Studio",
        "width": 1340,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "resizable": true,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
